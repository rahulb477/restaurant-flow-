rules_version = '2';

/**
 * CafePilot Cloud Storage rules.
 *
 * Layout: restaurants/{restaurantId}/{folder}/{file}
 *   folders: logo | menu | products | scratch   public-read images (shown to customers), written by OWNER/MANAGER
 *            qr | invoices                       members-only, never public
 *
 * Every write requires: signed in + ACTIVE membership of THAT restaurant (looked up in Firestore, never a client claim) +
 * an allowed role + an image content type + a size cap. Invoices are written by the server only (Admin SDK bypasses rules).
 *
 * NOTE: Storage rules cannot read environment variables. The 5 MB cap below must match MAX_UPLOAD_MB /
 * NEXT_PUBLIC_MAX_UPLOAD_MB (default 5). Change them together.
 *
 * Requires the Firebase Storage service agent to be allowed to read Firestore (see FIREBASE_SETUP.md).
 */
service firebase.storage {
  match /b/{bucket}/o {

    function memberDoc(rid) {
      return firestore.get(/databases/(default)/documents/restaurants/$(rid)/members/$(request.auth.uid));
    }
    function isActiveMember(rid) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/restaurants/$(rid)/members/$(request.auth.uid))
        && memberDoc(rid).data.status == 'ACTIVE';
    }
    function hasRole(rid, roles) {
      return isActiveMember(rid) && memberDoc(rid).data.role in roles;
    }
    function validImage() {
      return request.resource != null
        && request.resource.contentType.matches('image/(png|jpeg|webp)')
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }

    match /restaurants/{rid} {
      // logo: owner only (it is a Settings change)
      match /logo/{file} {
        allow read: if true;
        allow create, update: if hasRole(rid, ['OWNER']) && validImage();
        allow delete: if hasRole(rid, ['OWNER']);
      }
      // menu / product / scratch imagery: owner or manager
      match /{folder}/{file} {
        allow read: if folder in ['menu', 'products', 'scratch'];
        allow create, update: if folder in ['menu', 'products', 'scratch'] && hasRole(rid, ['OWNER', 'MANAGER']) && validImage();
        allow delete: if folder in ['menu', 'products', 'scratch'] && hasRole(rid, ['OWNER', 'MANAGER']);
      }
      // QR images: members read, owner/manager write
      match /qr/{file} {
        allow read: if isActiveMember(rid);
        allow create, update: if hasRole(rid, ['OWNER', 'MANAGER']) && validImage();
        allow delete: if hasRole(rid, ['OWNER', 'MANAGER']);
      }
      // invoices: billing staff read; written by the server only
      match /invoices/{file} {
        allow read: if hasRole(rid, ['OWNER', 'MANAGER', 'CASHIER']);
        allow write: if false;
      }
    }
  }
}
