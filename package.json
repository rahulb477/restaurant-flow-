{
  "name": "cafepilot",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "npx --yes firebase-tools emulators:exec --only firestore,storage \"vitest run tests/rules\"",
    "emulators": "npx --yes firebase-tools emulators:start --only auth,firestore,storage",
    "firebase:deploy:rules": "npx --yes firebase-tools deploy --only firestore:rules,firestore:indexes,storage"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.49.0",
    "next": "16.2.6",
    "qrcode.react": "^4.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  },
  "description": "CafePilot \u2014 cafe & restaurant management SaaS on Next.js and Firebase (Auth, Firestore, Storage)."
}
