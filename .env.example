# ──────────────────────────────────────────────────────────────────────────────
# CafePilot environment template.  Copy to `.env` (git-ignored) and fill in.
# NEVER commit real values.  Only variables prefixed NEXT_PUBLIC_ reach the browser;
# everything else is server-only and is read exclusively through src/config/env.ts.
# ──────────────────────────────────────────────────────────────────────────────

# ── App (public) ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=CafePilot
# Public base URL (used in invite / payment-return links). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_MAX_UPLOAD_MB=5
# Optional map provider for the geofence picker (defaults to key-less OpenStreetMap)
# NEXT_PUBLIC_MAP_PROVIDER=
# NEXT_PUBLIC_MAP_API_KEY=

# ── Firebase web app (public — safe to expose; Firebase console → Project settings → Your apps) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Local development against the Firebase Emulator Suite (`npm run emulators`)
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# NEXT_PUBLIC_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# Server side emulator wiring (used by firebase-admin automatically when set):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# ── Firebase Admin (SERVER ONLY — service account; Firebase console → Project settings → Service accounts) ──
# Option A (recommended on hosts that support multi-line secrets): the whole JSON, minified onto one line
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: the same JSON, base64-encoded
# FIREBASE_SERVICE_ACCOUNT_BASE64=
# Option C: discrete values (keep the \n escapes in the key, wrap it in double quotes)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# Aliases also accepted: FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY
# Option D: Application Default Credentials (Cloud Run / GCE / `gcloud auth application-default login`)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Optional override of the default storage bucket used by the Admin SDK
# FIREBASE_STORAGE_BUCKET=

# ── Session ───────────────────────────────────────────────────────────────────
# Lifetime of the httpOnly `__session` cookie in days (clamped 1–14)
SESSION_COOKIE_DAYS=5

# ── Platform fee & usage billing (platform level; the per-restaurant fee MODE lives in Firestore) ──
# Fee per eligible QR order, in minor units (100 = ₹1.00)
PLATFORM_FEE_MINOR=100
# When the unsettled balance reaches this amount, new QR orders are blocked (if the restaurant enables blocking)
SETTLEMENT_THRESHOLD_MINOR=50000
# UPI ID restaurants pay their platform balance to (shown on the Usage page)
PLATFORM_UPI_ID=
# Shared secret for the operator endpoint POST /api/admin/settlements/{id}
PLATFORM_ADMIN_SECRET=

# ── Online payments (optional; provider-agnostic — nothing is enabled until PAYMENT_PROVIDER is set) ──
# Supported adapters: razorpay (Payment Links).  Webhook URL: {APP_URL}/api/payments/webhook
PAYMENT_PROVIDER=
PAYMENT_KEY_ID=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# ── AI menu digitization (optional; any OpenAI-compatible vision chat-completions API) ──
AI_API_KEY=
AI_MODEL=
# AI_BASE_URL=https://api.openai.com/v1

# ── Email: invoices and staff invitations (optional; Resend-compatible REST API) ──
EMAIL_API_KEY=
EMAIL_FROM=
# EMAIL_API_URL=https://api.resend.com/emails

# ── Misc ──────────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=5
ORDER_ID_PREFIX=
ENCRYPTION_SECRET=
SENTRY_DSN=
